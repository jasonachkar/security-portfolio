# Environment
APP_ENV=local
LOG_LEVEL=INFO

# Auth (simple demo bearer token; replace with OAuth in real deployments)
AUTH_TOKEN=change-me
# Comma-separated list of allowed domains or CIDR ranges (best-effort validation).
ALLOWED_TARGETS=localhost,127.0.0.1,example.com

# Database
DATABASE_URL=postgresql+psycopg://security-assessment-orchestrator:security-assessment-orchestrator@db:5432/security-assessment-orchestrator
# Redis
REDIS_URL=redis://redis:6379/0
# Orchestrator toggles
ENABLE_NMAP=true
ENABLE_ZAP=true
ENABLE_TRIVY=false

# Optional: image ref for Trivy scanning (if enabled)
TRIVY_IMAGE=alpine:3.20
