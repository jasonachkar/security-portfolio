{
  "name": "@defensive-security-platform/reviewer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:data": "tsx ../../scripts/fetch-github-stats.ts && tsx ../../scripts/summarize-scans.ts",
    "dev": "npm run generate:data && vite",
    "prebuild": "npm run generate:data",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test scripts/no-overclaiming.test.mjs",
    "test:e2e": "playwright test",
    "evidence:screenshots": "tsx scripts/generate-screenshots.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "0.468.0",
    "prop-types": "^15.8.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "^7.15.1",
    "topojson-client": "^3.1.0",
    "vite": "^6.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.22.3",
    "typescript": "5.7.2"
  }
}
