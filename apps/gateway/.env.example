# Local-only development values. Replace for any shared environment.
APP_ENV=local
PORT=3000
HOST=0.0.0.0
JWT_SECRET=replace-with-local-random-secret
COOKIE_SECRET=replace-with-local-cookie-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SCANNER_URL=http://vulnerability-scanner:8080
NETWORK_URL=http://network-analyzer:8081
ASSESSMENT_URL=http://assessment-orchestrator:8082
UPSTREAM_ALLOWLIST=vulnerability-scanner,network-analyzer,assessment-orchestrator,localhost,127.0.0.1
