{
  "version": 2,
  "builds": [
    {
      "src": "apps/reviewer-ui/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "apps/scan-engine/src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/scan-engine/src/index.ts"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "apps/reviewer-ui/dist/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
